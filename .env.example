# --- LLM endpoint: any OpenAI-compatible server ---
# Own vLLM on AMD (ROCm):   LLM_BASE_URL=http://<host>:8000/v1   LLM_API_KEY=EMPTY
# AMD Token Factory / other hosted API: set its base URL and key here.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# LLM_TEMPERATURE=0.6
# LLM_TIMEOUT_S=180
# Send enable_thinking=False to Qwen3 chat templates (faster, shorter answers)
# LLM_DISABLE_THINKING=1
# Offline deterministic fake LLM (rehearsals / tests)
# LLM_MOCK=1

TARGET_TICKER=SPY
MAX_IDEAS=3
MAX_ITERATIONS=5
# RECURSION_LIMIT=100

# --- Sandbox ---
# SANDBOX_TIMEOUT_S=30
# TRANSACTION_COST_BPS=1
# TRAIN_FRACTION=0.7

# --- Audit gates (out-of-sample) ---
BENCHMARK_SHARPE=1.5
MAX_DRAWDOWN_LIMIT=0.15
DEMO_MODE=false
DEMO_BENCHMARK_SHARPE=0.5
DEMO_MAX_DRAWDOWN_LIMIT=0.25
